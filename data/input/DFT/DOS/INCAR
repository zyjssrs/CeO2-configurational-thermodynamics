 SYSTEM = CeO2-111-ovac-11Au
####################################################################
#Startparameter
 PREC      = medium     medium, high low
 ISTART    = 0          job   : 0-new  1-cont  2-samecut
 ICHARG    = 2          charge: 1-file 2-atom 10-const
 ISPIN     = 2          spin polarized calculation?
 GGA       = PE         Perdew-Burke-Ernzerhof Functional
#Electronic Relaxation
 ENCUT     = 400.0      cut-off energy (eV)
 ISMEAR    = 0          0:Gaussian -1:Fermi -5:Tetrahedron method
 SIGMA     = 0.05        broadening (eV)
 NELM      = 500        maximum number of electronic SC steps
 NELMIN    = 8          minimum number of electronic SC steps
 NELDOL    = -8
 NELMDL    = -8
 EDIFF     = 1E-4       stopping-criterion for electronic SC-loop
 IALGO     = 38         algorithm
# ALGO     = F         algorithm
 LDIAG     = T          sub-space diagonalisation
 LREAL     = Auto       real-space projection
 MAGMOM    = 189*0 2*2       magnetic moments
#Mixing Parameters
 IMIX      = 1
 AMIX      = 0.05
 BMIX      = 0.001
 AMIX_MAG  = 0.2
 BMIX_MAG  = 0.0001
 MAXMIX    = -50
 LMAXMIX   = 6
 ADDGRID   = .TRUE.
#Writing Parameters
 LWAVE     = F          write WAVECAR
 LCHARG    = T          write CHGCAR
 LVTOT     = F          write LOCPOT
# LELF      = F          write ELFCAR
 LORBIT    = 11         write DOSCAR and PROCAR
# EMIN = -60
# EMAX = 60
 NEDOS = 2000
# NBANDS = 1800
####################################################################
#Ionic relaxation
 ISIF      = 2          stress and relaxation
 ISYM      = 0          symmetry off
 POTIM     = 0.2
 EDIFFG    = -0.05      stopping-criterion for ionic relaxation loop
 NSW       = 0          number of steps for ionic relaxation loop
 IBRION    = -1         ionic relax: 0-MD 1-quasi-New 2-CG
# NFREE    = 10         initial steepest desc
####################################################################
#DFT+U
 LDAU      = T
 LDAUTYPE  = 2
 LDAUL     = -1 3 
 LDAUU     = 0.00 5.00 
 LDAUJ     = 0.00 0.00 
 LDAUPRINT = 0
 LASPH     = T
####################################################################

NPAR=8
